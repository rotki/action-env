{
  "name": "@rotki/action-env",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@12.12.1",
  "description": "Loads environment variables from a .env file",
  "type": "module",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotki/action-env.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "package": "rollup -c rollup.config.mjs",
    "test": "vitest run",
    "all": "pnpm run build && pnpm run lint && pnpm run package && pnpm test",
    "preinstall": "npx only-allow pnpm",
    "release": "bumpp --no-push"
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@rotki/eslint-config": "5.0.1",
    "@rotki/eslint-plugin": "1.3.2",
    "@types/node": "24.19.2",
    "bumpp": "12.3.0",
    "eslint": "9.39.5",
    "rollup": "4.64.7",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  }
}
